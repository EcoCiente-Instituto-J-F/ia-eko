# =================================
# Application
# =================================
APP_NAME=EcoCiente IA API
APP_VERSION=1.1.0
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# =================================
# AI / LLM
# =================================
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# =================================
# Embeddings / RAG
# =================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_BASE_PATH=data/FAQ_KNOWLEDGE_BASE.md
ENABLE_EXTERNAL_SOURCE=true
EXTERNAL_SOURCE_URL=https://sinir.gov.br/
EXTERNAL_SOURCE_TITLE=SINIR — Sistema Nacional de Informações sobre a Gestão dos Resíduos Sólidos
EXTERNAL_TIMEOUT_SECONDS=8
RAG_TOP_K=4
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# =================================
# PostgreSQL
# =================================
POSTGRES_URL=postgresql://ecociente:change_me@localhost:5432/ecociente
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=8
POSTGRES_CONNECT_TIMEOUT=3

# =================================
# MongoDB
# =================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ecociente
MONGODB_TIMEOUT_MS=2500

# =================================
# Redis
# =================================
REDIS_URL=redis://localhost:6379/0
REDIS_SOCKET_TIMEOUT=2.5

# =================================
# Sessions / runtime
# =================================
SESSION_TTL_SECONDS=1800
STORAGE_MODE=external
ALLOW_STORAGE_FALLBACK=true
JUDGE_MAX_CORRECTIONS=1
MEMORY_MAX_MESSAGES=20
MEMORY_KEEP_RECENT_MESSAGES=6

# =================================
# Limites de uso
# =================================
# Respostas do /chat por usuário por dia (vira à meia-noite de QUOTA_TIMEZONE).
# 0 = sem limite para o perfil.
QUOTA_ENABLED=true
QUOTA_TIMEZONE=America/Sao_Paulo
QUOTA_USUARIO_COMUM=20
QUOTA_MORADOR_RESIDENCIAL=40
QUOTA_USUARIO_COMERCIAL=50
QUOTA_COOPERATIVA=80
QUOTA_SINDICO_RESIDENCIAL=100
QUOTA_SINDICO_COMERCIAL=100
# Perfis cuja sessão termina antes de acionar o resumo de memória (LLM extra).
# Com MEMORY_MAX_MESSAGES=20, são 10 perguntas por sessão. Use NONE para desligar.
QUOTA_NO_COMPACTION_PROFILES=USUARIO_COMUM
# Anti-rajada, qualquer perfil.
RATE_LIMIT_PER_MINUTE=10

# =================================
# Tracing de LLM (opcional)
# =================================
# none | langfuse | langsmith
TRACING_PROVIDER=none
# Mascara CPF, CNPJ, e-mail, telefone, CEP e tokens antes de enviar ao provedor.
TRACING_MASK_PII=true
# Por padrão o tracing fica desligado com LLM_PROVIDER=mock.
TRACING_IN_MOCK=false
# Langfuse self-hosted: docker-compose.langfuse.yml (chaves de dev pré-criadas lá).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecociente-ia

# =================================
# External APIs
# =================================
AUTH_API_URL=
AUTH_API_TIMEOUT=8
AUTH_API_RETRIES=2

# =================================
# Calendar API / MCP
# =================================
CALENDAR_API_BASE_URL=http://localhost:9800
CALENDAR_API_TIMEOUT_SECONDS=10
CALENDAR_API_RETRIES=2

# Exclusivo para integração real de testes. Nunca preencha com credencial de produção.
CALENDAR_TEST_BEARER_TOKEN=
RUN_CALENDAR_INTEGRATION_TESTS=false
A2A_PUBLIC_URL=http://127.0.0.1:8000/a2a/jsonrpc/

# =================================
# Test-only identity shortcut
# =================================
# Só funciona com APP_ENV=test.
ALLOW_TEST_IDENTITY_HEADERS=false

# =================================
# Real integration tests (NEVER production)
# =================================
RUN_INTEGRATION_TESTS=false
TEST_POSTGRES_URL=
TEST_MONGODB_URI=
TEST_MONGODB_DATABASE=ecociente_test
TEST_REDIS_URL=
TEST_REDIS_PREFIX=ecociente:test:

# ================================
# NEO4J
# ================================
NEO4J_URI=neo4j+s://instanceid.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpasswd
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=instanceid
AURA_INSTANCENAME=My instance